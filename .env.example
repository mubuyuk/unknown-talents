# Kopiera den här filen till .env och fyll i dina egna värden.
# .env ignoreras av Git – checka aldrig in riktiga lösenord eller anslutningssträngar.

# Obligatorisk: anslutning till din egen MongoDB.
# Lokal MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/winner
# MongoDB Atlas (exempel – byt användare, lösenord och kluster):
# MONGO_URI=mongodb+srv://<användare>:<lösenord>@<kluster>.mongodb.net/winner

# Obligatorisk: lösenord för admin-läget i appen. Välj ett eget, långt lösenord.
ADMIN_PASSWORD=byt-till-ett-eget-langt-losenord

# Valfri: port för webbservern (standard 5000).
# PORT=5000

# Valfri: planhyra per match i kr för betalningsöversikten (standard 550).
# MATCH_PRICE=550
